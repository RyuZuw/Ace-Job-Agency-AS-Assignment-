@model ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    var activeSessions = ViewBag.ActiveSessions as IEnumerable<AceJobAgency.Models.UserSession> ?? new List<AceJobAgency.Models.UserSession>();
    var currentSessionId = ViewBag.CurrentSessionId as string;
}

<div class="row">
    <div class="col-md-4">
        <!-- Profile Card -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>Profile</h5>
            </div>
            <div class="card-body text-center">
                <div class="mb-3">
                    <i class="bi bi-person-circle text-secondary" style="font-size: 5rem;"></i>
                </div>
                <h5>@Model.FullName</h5>
                <p class="text-muted mb-1">@Model.Email</p>
                <p class="text-muted">
                    <span class="badge bg-info">@Model.Gender</span>
                    <span class="badge bg-secondary">@Model.Age years old</span>
                </p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-shield-check me-2"></i>Two-Factor Auth</span>
                    @if (Model.IsTwoFactorEnabled)
                    {
                        <span class="badge bg-success">Enabled</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Disabled</span>
                    }
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-calendar-check me-2"></i>Last Password Change</span>
                    <span class="text-muted">@Model.LastPasswordChange.ToString("MMM dd, yyyy")</span>
                </li>
            </ul>
            <div class="card-body">
                @if (!Model.IsTwoFactorEnabled)
                {
                    <a asp-controller="Account" asp-action="EnableTwoFactor" class="btn btn-outline-primary btn-sm w-100">
                        <i class="bi bi-shield-lock me-2"></i>Enable 2FA
                    </a>
                }
                else
                {
                    <form asp-controller="Account" asp-action="DisableTwoFactor" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100" 
                                onclick="return confirm('Are you sure you want to disable two-factor authentication? This will make your account less secure.');">
                            <i class="bi bi-shield-x me-2"></i>Disable 2FA
                        </button>
                    </form>
                }
            </div>
        </div>

        <!-- Resume Card -->
        @if (!string.IsNullOrEmpty(Model.ResumePath))
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Resume</h5>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>File:</strong> @Model.ResumeFileName</p>
                    <a asp-controller="Home" asp-action="DownloadResume" class="btn btn-success btn-sm">
                        <i class="bi bi-download me-2"></i>Download Resume
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="col-md-8">
        <!-- Personal Information -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Personal Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>First Name:</strong> @Model.FirstName</p>
                        <p><strong>Last Name:</strong> @Model.LastName</p>
                        <p><strong>Email:</strong> @Model.Email</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>NRIC:</strong> @Model.NRIC</p>
                        <p><strong>Gender:</strong> @Model.Gender</p>
                        <p><strong>Date of Birth:</strong> @Model.DateOfBirth.ToString("MMM dd, yyyy")</p>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.WhoAmI))
                {
                    <hr />
                    <h6>Who Am I</h6>
                    <p class="text-muted">@Model.WhoAmI</p>
                }
            </div>
        </div>

        <!-- Active Sessions -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-laptop me-2"></i>Active Sessions</h5>
                @if (activeSessions.Count() > 1)
                {
                    <form asp-controller="Home" asp-action="TerminateAllOtherSessions" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning btn-sm" 
                                onclick="return confirm('Are you sure you want to terminate all other sessions?');">
                            <i class="bi bi-x-circle me-1"></i>Terminate All Others
                        </button>
                    </form>
                }
            </div>
            <div class="card-body">
                @if (activeSessions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Device</th>
                                    <th>IP Address</th>
                                    <th>Last Activity</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var session in activeSessions)
                                {
                                    <tr class="@(session.SessionId == currentSessionId ? "table-success" : "")">
                                        <td>
                                            @if (session.SessionId == currentSessionId)
                                            {
                                                <span class="badge bg-success">Current</span>
                                            }
                                            <small>@session.UserAgent?.Substring(0, Math.Min(50, session.UserAgent?.Length ?? 0))...</small>
                                        </td>
                                        <td><small>@session.IpAddress</small></td>
                                        <td><small>@session.LastActivity.ToString("MMM dd, HH:mm")</small></td>
                                        <td>
                                            @if (session.SessionId != currentSessionId)
                                            {
                                                <form asp-controller="Home" asp-action="TerminateSession" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="sessionId" value="@session.SessionId" />
                                                    <button type="submit" class="btn btn-danger btn-sm">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No active sessions found.</p>
                }
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Recent Activity</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentActivity.Any())
                {
                    <div class="timeline">
                        @foreach (var activity in Model.RecentActivity)
                        {
                            <div class="d-flex mb-3">
                                <div class="flex-shrink-0">
                                    @if (activity.IsSuccess)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    }
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">@activity.Action</h6>
                                    <p class="mb-0 text-muted small">@activity.Description</p>
                                    <small class="text-muted">@activity.Timestamp.ToString("MMM dd, yyyy HH:mm") from @activity.IpAddress</small>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">No recent activity found.</p>
                }
            </div>
        </div>
    </div>
</div>
