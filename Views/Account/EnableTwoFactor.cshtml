@model EnableTwoFactorViewModel

@{
    ViewData["Title"] = "Enable Two-Factor Authentication";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Enable Two-Factor Authentication</h4>
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-check text-primary" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Set Up Authenticator App</h5>
                    <p class="text-muted">Scan the QR code below with your authenticator app</p>
                </div>

                <div class="text-center mb-4">
                    <img src="data:image/png;base64,@Model.QrCodeImageBase64" alt="QR Code" class="img-fluid border p-2" style="max-width: 250px;" />
                </div>

                <div class="alert alert-info" role="alert">
                    <h6 class="alert-heading"><i class="bi bi-info-circle-fill me-2"></i>Can't scan the QR code?</h6>
                    <p class="mb-0">Enter this key manually in your authenticator app:</p>
                    <code class="d-block mt-2 p-2 bg-light border rounded">@Model.ManualEntryKey</code>
                </div>

                <hr />

                <form asp-controller="Account" asp-action="EnableTwoFactor" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="VerificationCode" class="form-control text-center fs-4" autocomplete="off" aria-required="true" placeholder="000000" maxlength="6" />
                        <label asp-for="VerificationCode" class="form-label"></label>
                        <span asp-validation-for="VerificationCode" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle me-2"></i>Verify and Enable
                        </button>
                    </div>

                    <div class="mt-3 text-center">
                        <a asp-controller="Home" asp-action="Profile" class="text-decoration-none">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-4 border-info">
            <div class="card-body">
                <h6 class="card-title text-info"><i class="bi bi-phone me-2"></i>Recommended Authenticator Apps</h6>
                <ul class="small text-muted mb-0">
                    <li>Google Authenticator (iOS/Android)</li>
                    <li>Microsoft Authenticator (iOS/Android)</li>
                    <li>Authy (iOS/Android/Desktop)</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const codeInput = document.querySelector('input[name="VerificationCode"]');
            if (codeInput) {
                codeInput.focus();
                codeInput.addEventListener('input', function(e) {
                    e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6);
                });
            }
        });
    </script>
}
