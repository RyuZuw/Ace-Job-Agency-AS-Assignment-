@model ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-key me-2"></i>Change Password</h4>
            </div>
            <div class="card-body">
                <form asp-controller="Account" asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="current password" />
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="new password" />
                        <label asp-for="NewPassword" class="form-label"></label>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="confirm password" />
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle me-2"></i>Change Password
                        </button>
                    </div>

                    <div class="mt-3 text-center">
                        <a asp-controller="Home" asp-action="Profile" class="text-decoration-none">Back to Profile</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-4 border-info">
            <div class="card-body">
                <h6 class="card-title text-info"><i class="bi bi-shield-check me-2"></i>Password Policy</h6>
                <ul class="small text-muted mb-0">
                    <li>At least 12 characters long</li>
                    <li>Must contain uppercase, lowercase, number, and special character</li>
                    <li>Cannot reuse your last 2 passwords</li>
                    <li>Must wait at least 1 day between password changes</li>
                    <li>Password expires after 90 days</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
