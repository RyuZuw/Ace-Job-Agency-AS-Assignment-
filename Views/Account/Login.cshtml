@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-box-arrow-in-right me-2"></i>Login</h4>
            </div>
            <div class="card-body">
                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" autocomplete="off" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Email" class="form-label"></label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                        <label asp-for="Password" class="form-label"></label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <!-- Hidden field for reCaptcha token -->
                    <input type="hidden" asp-for="RecaptchaToken" id="recaptchaToken" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Login
                        </button>
                    </div>

                    <div class="mt-3 text-center">
                        <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none">Forgot your password?</a>
                    </div>

                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="mb-0">Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-decoration-none">Register here</a></p>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-4 border-info">
            <div class="card-body">
                <h6 class="card-title text-info"><i class="bi bi-info-circle-fill me-2"></i>Security Information</h6>
                <ul class="small text-muted mb-0">
                    <li>Your account will be locked after 3 failed login attempts</li>
                    <li>Account lockout lasts for 30 minutes</li>
                    <li>Two-factor authentication is available for enhanced security</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // reCaptcha v3
        (function() {
            var form = document.getElementById('loginForm');
            var submitting = false;
            if (typeof grecaptcha !== 'undefined') {
                grecaptcha.ready(function() {
                    form.addEventListener('submit', function(e) {
                        if (submitting) return;
                        e.preventDefault();
                        submitting = true;
                        grecaptcha.execute('@ViewBag.RecaptchaSiteKey', { action: 'login' }).then(function(token) {
                            document.getElementById('recaptchaToken').value = token;
                            form.submit();
                        }).catch(function() {
                            form.submit();
                        });
                    });
                });
            }
        })();
    </script>
}
